<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>GroessereRucksaecke</AssemblyName>
    <RootNamespace>GroessereRucksaecke</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <NoWarn>$(NoWarn);CS1701;CS1702;NU1701</NoWarn>
    <GameDir Condition="'$(GameDir)' == ''">/mnt/nvmegames/Games/SPT-416</GameDir>
    <ServerDir Condition="'$(ServerDir)' == ''">$(GameDir)/SPT_Runtime</ServerDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="SPTarkov.Server.Core"><HintPath>$(ServerDir)/SPTarkov.Server.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SPTarkov.DI"><HintPath>$(ServerDir)/SPTarkov.DI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SPTarkov.Common"><HintPath>$(ServerDir)/SPTarkov.Common.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SemanticVersioning"><HintPath>$(ServerDir)/SemanticVersioning.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!-- Nur mit -p:Installieren=true kopieren, sonst ueberschreibt schon ein
       Probebau die eingebaute Fassung. Die rucksaecke.json wird NICHT
       mitkopiert, wenn sie drueben schon liegt - sonst waeren die
       Einstellungen nach jedem Bau wieder zurueckgesetzt. -->
  <Target Name="InsSpiel" AfterTargets="Build" Condition="'$(Installieren)' == 'true'">
    <MakeDir Directories="$(ServerDir)/user/mods/GroessereRucksaecke" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ServerDir)/user/mods/GroessereRucksaecke" />
    <Copy SourceFiles="rucksaecke.json"
          DestinationFolder="$(ServerDir)/user/mods/GroessereRucksaecke"
          Condition="!Exists('$(ServerDir)/user/mods/GroessereRucksaecke/rucksaecke.json')" />
    <Message Importance="high" Text="-> user/mods/GroessereRucksaecke/ (Server neu starten)" />
  </Target>

</Project>
